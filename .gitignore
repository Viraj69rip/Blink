# ---------- Flutter (blink_app) ----------
# The existing blink_app/.gitignore handles most Flutter specifics.
# These catch anything that leaks to root or isn't covered:
blink_app/build/
blink_app/.dart_tool/
blink_app/.flutter-plugins
blink_app/.flutter-plugins-dependencies
blink_app/.packages

# ---------- ESP toolchain ----------
ESP code/toolchain/

